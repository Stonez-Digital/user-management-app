APP_PORT=8080
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Database: use postgres in production, sqlite for local development
DB_DRIVER=postgres
DATABASE_URL=
# Optional fail-closed guard for a restricted PostgreSQL API runtime role.
# Enable only after tenant-aware RLS policies and request-scoped DB transactions are deployed.
REQUIRE_NOBYPASSRLS=false

# Optional separate PostgreSQL connection used only for application migrations.
# Keep this credential out of the API runtime role; falls back to DATABASE_URL when unset.
MIGRATION_DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=usersdb
DB_SSLMODE=require
DB_PATH=users.db

APP_ENV=production

# Bulk onboarding credential emails can continue to use SMTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Stonez Digital
# Optional Resend API key. Password-reset delivery uses HTTPS when this is set.
# For existing Resend SMTP credentials, SMTP_PASSWORD is reused as the API key
# when SMTP_HOST=smtp.resend.com and SMTP_USERNAME=resend.
RESEND_API_KEY=
# Canonical school portal URLs; do not use the workers.dev fallback for emails.
APP_LOGIN_URL=https://app.stonezdigital.com.ng
# Absolute frontend URL; the API appends the one-time token as a URL fragment (#token=...)
APP_PASSWORD_RESET_URL=https://app.stonezdigital.com.ng/reset-password
