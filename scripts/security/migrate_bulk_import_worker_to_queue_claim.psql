\\set ON_ERROR_STOP on
-- Operator-run, transactional transition for an existing claim login.
-- Removes broad API-runtime membership without rotating the worker password.
BEGIN;

DO $preflight$
DECLARE
    worker_role pg_roles%ROWTYPE;
    api_role pg_roles%ROWTYPE;
    claim_role pg_roles%ROWTYPE;
    owner_role pg_roles%ROWTYPE;
BEGIN
    SELECT * INTO worker_role FROM pg_roles WHERE rolname = 'stonez_bulk_worker';
    IF NOT FOUND THEN
        RAISE EXCEPTION 'stonez_bulk_worker login is missing';
    END IF;
    SELECT * INTO api_role FROM pg_roles WHERE rolname = 'stonez_api_runtime';
    IF NOT FOUND THEN
        RAISE EXCEPTION 'stonez_api_runtime is missing';
    END IF;
    SELECT * INTO claim_role FROM pg_roles WHERE rolname = 'stonez_bulk_queue_claim';
    IF NOT FOUND THEN
        RAISE EXCEPTION 'stonez_bulk_queue_claim is missing; provision and verify queue roles first';
    END IF;
    SELECT * INTO owner_role FROM pg_roles WHERE rolname = 'stonez_bulk_queue_owner';
    IF NOT FOUND THEN
        RAISE EXCEPTION 'stonez_bulk_queue_owner is missing';
    END IF;

    IF NOT worker_role.rolcanlogin OR worker_role.rolsuper OR worker_role.rolbypassrls
       OR worker_role.rolcreatedb OR worker_role.rolcreaterole OR worker_role.rolreplication
       OR NOT worker_role.rolinherit THEN
        RAISE EXCEPTION 'stonez_bulk_worker has unsafe login attributes';
    END IF;
    IF api_role.rolcanlogin OR api_role.rolsuper OR api_role.rolbypassrls
       OR api_role.rolcreatedb OR api_role.rolcreaterole OR NOT api_role.rolinherit THEN
        RAISE EXCEPTION 'stonez_api_runtime has unsafe role attributes';
    END IF;
    IF claim_role.rolcanlogin OR claim_role.rolsuper OR claim_role.rolbypassrls
       OR claim_role.rolcreatedb OR claim_role.rolcreaterole OR claim_role.rolreplication
       OR claim_role.rolinherit THEN
        RAISE EXCEPTION 'stonez_bulk_queue_claim has unsafe role attributes';
    END IF;
    IF pg_has_role('stonez_bulk_worker', 'stonez_bulk_queue_owner', 'MEMBER') THEN
        RAISE EXCEPTION 'stonez_bulk_worker has queue-owner membership';
    END IF;
    IF EXISTS (
        SELECT 1 FROM pg_auth_members
         WHERE member = worker_role.oid
           AND roleid NOT IN (api_role.oid, claim_role.oid)
    ) THEN
        RAISE EXCEPTION 'stonez_bulk_worker has an unexpected role membership';
    END IF;
    IF NOT EXISTS (
        SELECT 1 FROM pg_auth_members
         WHERE member = (SELECT oid FROM pg_roles WHERE rolname = current_user)
           AND roleid = api_role.oid
           AND admin_option
    ) OR NOT EXISTS (
        SELECT 1 FROM pg_auth_members
         WHERE member = (SELECT oid FROM pg_roles WHERE rolname = current_user)
           AND roleid = claim_role.oid
           AND admin_option
    ) THEN
        RAISE EXCEPTION 'operator requires existing ADMIN OPTION on both API and queue-claim group roles';
    END IF;
    IF NOT has_function_privilege('stonez_bulk_queue_claim',
        'stonez_internal.claim_next_bulk_import_job(uuid)', 'EXECUTE') THEN
        RAISE EXCEPTION 'queue-claim group cannot execute the installed claim function';
    END IF;
END
$preflight$;

REVOKE stonez_api_runtime FROM stonez_bulk_worker;
GRANT stonez_bulk_queue_claim TO stonez_bulk_worker
    WITH ADMIN FALSE, INHERIT TRUE, SET FALSE;

DO $verify$
BEGIN
    IF NOT pg_has_role('stonez_bulk_worker', 'stonez_bulk_queue_claim', 'USAGE')
       OR pg_has_role('stonez_bulk_worker', 'stonez_bulk_queue_claim', 'SET')
       OR pg_has_role('stonez_bulk_worker', 'stonez_api_runtime', 'MEMBER')
       OR pg_has_role('stonez_bulk_worker', 'stonez_bulk_queue_owner', 'MEMBER')
       OR NOT has_function_privilege('stonez_bulk_worker',
           'stonez_internal.claim_next_bulk_import_job(uuid)', 'EXECUTE') THEN
        RAISE EXCEPTION 'worker login did not transition to the isolated queue-claim boundary';
    END IF;
    IF EXISTS (
        SELECT 1 FROM pg_auth_members
         WHERE member = (SELECT oid FROM pg_roles WHERE rolname = 'stonez_bulk_worker')
           AND roleid <> (SELECT oid FROM pg_roles WHERE rolname = 'stonez_bulk_queue_claim')
    ) THEN
        RAISE EXCEPTION 'worker login retains an unexpected role membership';
    END IF;
    IF EXISTS (
        SELECT 1 FROM pg_class AS relation
        JOIN pg_namespace AS namespace ON namespace.oid = relation.relnamespace
        WHERE namespace.nspname = 'public'
          AND relation.relkind IN ('r','p','v','m')
          AND (has_table_privilege('stonez_bulk_worker', relation.oid, 'SELECT')
            OR has_table_privilege('stonez_bulk_worker', relation.oid, 'INSERT')
            OR has_table_privilege('stonez_bulk_worker', relation.oid, 'UPDATE')
            OR has_table_privilege('stonez_bulk_worker', relation.oid, 'DELETE'))
    ) THEN
        RAISE EXCEPTION 'worker login retains direct public-table privileges';
    END IF;
    IF EXISTS (
        SELECT 1 FROM pg_class AS relation
        JOIN pg_namespace AS namespace ON namespace.oid = relation.relnamespace
        WHERE namespace.nspname = 'public'
          AND relation.relkind = 'S'
          AND (has_sequence_privilege('stonez_bulk_worker', relation.oid, 'USAGE')
            OR has_sequence_privilege('stonez_bulk_worker', relation.oid, 'SELECT')
            OR has_sequence_privilege('stonez_bulk_worker', relation.oid, 'UPDATE'))
    ) THEN
        RAISE EXCEPTION 'worker login retains public-sequence privileges';
    END IF;
    IF has_schema_privilege('stonez_bulk_worker', 'public', 'CREATE')
       OR has_schema_privilege('stonez_bulk_worker', 'stonez_internal', 'CREATE') THEN
        RAISE EXCEPTION 'worker login can create objects in application or internal schemas';
    END IF;
END
$verify$;

COMMIT;
