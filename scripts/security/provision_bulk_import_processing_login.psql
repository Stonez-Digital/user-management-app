\set ON_ERROR_STOP on
DO $$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'stonez_bulk_process_group'
                   AND NOT rolcanlogin AND NOT rolsuper AND NOT rolbypassrls
                   AND NOT rolcreatedb AND NOT rolcreaterole AND rolinherit) THEN
        RAISE EXCEPTION 'stonez_bulk_process_group is missing or unsafe; run the approved role preparation first';
    END IF;
    IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'stonez_bulk_process_login') THEN
        RAISE EXCEPTION 'stonez_bulk_process_login already exists; refusing to alter an existing login';
    END IF;
END
$$;

CREATE ROLE stonez_bulk_process_login
    LOGIN INHERIT
    CONNECTION LIMIT 5;

-- psql hides password input; no password is embedded in this script.
\password stonez_bulk_process_login

GRANT stonez_bulk_process_group TO stonez_bulk_process_login
    WITH ADMIN FALSE, INHERIT TRUE, SET FALSE;

DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM pg_roles
         WHERE rolname = 'stonez_bulk_process_login'
           AND rolcanlogin AND NOT rolsuper AND NOT rolcreatedb
           AND NOT rolcreaterole AND NOT rolbypassrls AND rolinherit
    ) THEN
        RAISE EXCEPTION 'processing login role attributes are unsafe';
    END IF;
    IF NOT pg_has_role('stonez_bulk_process_login', 'stonez_bulk_process_group', 'USAGE') THEN
        RAISE EXCEPTION 'processing login does not inherit the processing privilege group';
    END IF;
    IF pg_has_role('stonez_bulk_process_login', 'stonez_bulk_process_group', 'SET') THEN
        RAISE EXCEPTION 'processing login must not be able to SET ROLE to the processing group';
    END IF;
    IF pg_has_role('stonez_bulk_process_login', 'stonez_api_runtime', 'MEMBER')
       OR pg_has_role('stonez_bulk_process_login', 'stonez_bulk_queue_owner', 'MEMBER')
       OR pg_has_role('stonez_bulk_process_login', 'service_role', 'MEMBER') THEN
        RAISE EXCEPTION 'processing login must not inherit API, queue-owner, or service-role privileges';
    END IF;
END
$$;

SELECT
    rolname, rolcanlogin, rolsuper, rolcreatedb, rolcreaterole, rolbypassrls,
    rolinherit,
    pg_has_role('stonez_bulk_process_login', 'stonez_bulk_process_group', 'USAGE') AS inherits_processing_group,
    pg_has_role('stonez_bulk_process_login', 'stonez_bulk_process_group', 'SET') AS can_set_processing_group;
