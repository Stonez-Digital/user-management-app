\set ON_ERROR_STOP on
DO $preflight$
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM pg_roles
         WHERE rolname = 'stonez_bulk_worker_processing'
           AND NOT rolcanlogin AND NOT rolsuper AND NOT rolbypassrls
           AND NOT rolcreatedb AND NOT rolcreaterole
    ) THEN
        RAISE EXCEPTION 'stonez_bulk_worker_processing is missing or has unsafe attributes';
    END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'stonez_bulk_worker') THEN
        RAISE EXCEPTION 'the separate queue-claim login stonez_bulk_worker must already exist';
    END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'stonez_api_runtime')
       OR NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'stonez_bulk_queue_owner')
       OR NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'stonez_bulk_context_owner')
       OR NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'stonez_bulk_context_key_admin') THEN
        RAISE EXCEPTION 'API, queue, verifier-owner, and key-admin roles must be installed first';
    END IF;
    IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'stonez_bulk_worker_processing_login') THEN
        RAISE EXCEPTION 'stonez_bulk_worker_processing_login already exists; refusing to alter an existing login';
    END IF;
END
$preflight$;

-- This login is exclusively for tenant row processing. The existing
-- stonez_bulk_worker login remains the separate API-runtime/queue-claim path.
CREATE ROLE stonez_bulk_worker_processing_login
    LOGIN INHERIT
    CONNECTION LIMIT 5;
\password stonez_bulk_worker_processing_login

GRANT stonez_bulk_worker_processing TO stonez_bulk_worker_processing_login
    WITH ADMIN FALSE, INHERIT TRUE, SET FALSE;

DO $verify$
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM pg_roles
         WHERE rolname = 'stonez_bulk_worker_processing_login'
           AND rolcanlogin AND rolinherit
           AND NOT rolsuper AND NOT rolcreatedb AND NOT rolcreaterole AND NOT rolbypassrls
    ) THEN
        RAISE EXCEPTION 'processing login role attributes are not restricted';
    END IF;
    IF NOT pg_has_role('stonez_bulk_worker_processing_login', 'stonez_bulk_worker_processing', 'USAGE') THEN
        RAISE EXCEPTION 'processing login does not inherit signed-worker policies';
    END IF;
    IF pg_has_role('stonez_bulk_worker_processing_login', 'stonez_api_runtime', 'MEMBER')
       OR pg_has_role('stonez_bulk_worker_processing_login', 'stonez_bulk_queue_owner', 'MEMBER')
       OR pg_has_role('stonez_bulk_worker_processing_login', 'stonez_bulk_worker', 'MEMBER')
       OR pg_has_role('stonez_bulk_worker_processing_login', 'stonez_bulk_context_owner', 'MEMBER')
       OR pg_has_role('stonez_bulk_worker_processing_login', 'stonez_bulk_context_key_admin', 'MEMBER') THEN
        RAISE EXCEPTION 'processing login inherited a forbidden runtime, queue, owner, or key-admin role';
    END IF;
    IF EXISTS (
        SELECT 1 FROM pg_auth_members
         WHERE member = (SELECT oid FROM pg_roles WHERE rolname='stonez_bulk_worker_processing_login')
           AND roleid <> (SELECT oid FROM pg_roles WHERE rolname='stonez_bulk_worker_processing')
    ) THEN
        RAISE EXCEPTION 'processing login must have only the signed-worker group membership';
    END IF;
END
$verify$;

SELECT
    rolname, rolcanlogin, rolsuper, rolcreatedb, rolcreaterole, rolbypassrls, rolinherit,
    pg_has_role('stonez_bulk_worker_processing_login', 'stonez_bulk_worker_processing', 'USAGE') AS inherits_signed_worker_policy,
    pg_has_role('stonez_bulk_worker_processing_login', 'stonez_api_runtime', 'MEMBER') AS is_api_runtime_member,
    pg_has_role('stonez_bulk_worker_processing_login', 'stonez_bulk_queue_owner', 'MEMBER') AS is_queue_owner_member
FROM pg_roles
WHERE rolname = 'stonez_bulk_worker_processing_login';
