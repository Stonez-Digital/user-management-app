\set ON_ERROR_STOP on
DO $$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'stonez_bulk_worker') THEN
        RAISE EXCEPTION 'stonez_bulk_worker already exists; refusing to alter an existing login';
    END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'stonez_api_runtime') THEN
        RAISE EXCEPTION 'stonez_api_runtime is missing; install and verify the queue role boundary first';
    END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'stonez_bulk_queue_owner') THEN
        RAISE EXCEPTION 'stonez_bulk_queue_owner is missing; install and verify the queue role boundary first';
    END IF;
END
$$;

-- PostgreSQL defaults newly created roles to NOBYPASSRLS,
-- NOSUPERUSER, NOCREATEDB, and NOCREATEROLE. Leave those safe defaults
-- untouched; the assertions below verify them.
CREATE ROLE stonez_bulk_worker
    LOGIN INHERIT
    CONNECTION LIMIT 5;

-- psql hides both password prompts and sends only the encrypted verifier.
\\password stonez_bulk_worker

-- The login inherits only the restricted API group privileges. It cannot
-- administer the group or SET ROLE into it; the claim function checks effective
-- inherited membership via pg_has_role(..., 'USAGE').
GRANT stonez_api_runtime TO stonez_bulk_worker
    WITH ADMIN FALSE, INHERIT TRUE, SET FALSE;

DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM pg_roles
         WHERE rolname = 'stonez_bulk_worker'
           AND rolcanlogin
           AND NOT rolsuper
           AND NOT rolcreatedb
           AND NOT rolcreaterole
           AND NOT rolbypassrls
           AND rolinherit
    ) THEN
        RAISE EXCEPTION 'stonez_bulk_worker role attributes are not restricted';
    END IF;
    IF NOT pg_has_role('stonez_bulk_worker', 'stonez_api_runtime', 'USAGE') THEN
        RAISE EXCEPTION 'stonez_bulk_worker does not inherit stonez_api_runtime privileges';
    END IF;
    IF pg_has_role('stonez_bulk_worker', 'stonez_bulk_queue_owner', 'MEMBER') THEN
        RAISE EXCEPTION 'stonez_bulk_worker must not be a member of stonez_bulk_queue_owner';
    END IF;
    IF pg_has_role('stonez_bulk_worker', 'stonez_api_runtime', 'SET') THEN
        RAISE EXCEPTION 'stonez_bulk_worker must not be able to SET ROLE stonez_api_runtime';
    END IF;
END
$$;

SELECT
    rolname,
    rolcanlogin,
    rolsuper,
    rolcreatedb,
    rolcreaterole,
    rolbypassrls,
    rolinherit,
    pg_has_role('stonez_bulk_worker', 'stonez_api_runtime', 'USAGE') AS inherits_runtime_privileges,
    pg_has_role('stonez_bulk_worker', 'stonez_api_runtime', 'SET') AS can_set_runtime_role,
    pg_has_role('stonez_bulk_worker', 'stonez_bulk_queue_owner', 'MEMBER') AS is_queue_owner_member
FROM pg_roles
WHERE rolname = 'stonez_bulk_worker';
